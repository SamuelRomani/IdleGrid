{
  "name": "pokegrid",
  "version": "1.5.10",
  "description": "Rode 4 contas de Poke Idle World ao mesmo tempo, em uma janela so / Run 4 Poke Idle World accounts at once, in a single window",
  "main": "main.js",
  "author": "soufoka",
  "scripts": {
    "start": "electron .",
    "test": "node test/iv-math.test.js && node test/boot.test.js",
    "dist:win": "electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "multi-account",
    "poke-idle-world",
    "idle-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pokewg.pokegrid",
    "productName": "PokeGrid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "presets/**/*",
      "src/**/*",
      "tray.png",
      "package.json"
    ],
    "win": {
      "target": ["portable"]
    }
  }
}
